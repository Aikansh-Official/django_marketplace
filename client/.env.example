# ==============================================================================
# CampusXChange Client Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api
# Production: https://cxc-marketplace.onrender.com/api

# Data Security Layer Key (Must match backend DATA_SECURITY_KEY)
VITE_APP_SECURITY_KEY=your_base64_security_key_here

# Google OAuth Client ID (Optional if using Firebase)
VITE_GOOGLE_CLIENT_ID=

# Firebase Client Configuration (Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
