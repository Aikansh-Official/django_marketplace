web: gunicorn server.wsgi:application --bind 0.0.0.0:${PORT:-8000} --workers 3 --timeout 120 --keep-alive 5 --max-requests 1000 --max-requests-jitter 100 --forwarded-allow-ips "*" --access-logfile - --error-logfile -
release: python manage.py migrate --noinput && python manage.py collectstatic --noinput
