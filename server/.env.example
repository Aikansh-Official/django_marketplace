# ==============================================================================
# LPUTrade Server Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database: MongoDB connection URI (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campxchange?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/campxchange
MONGODB_URI=mongodb://localhost:27017/campxchange
MONGODB_NAME=campxchange
# Optional local input for configure_atlas.py; never commit a real password.
ATLAS_DATABASE_PASSWORD=
# Optional durable images in the same MongoDB database (default: cloudinary).
MEDIA_STORAGE_BACKEND=cloudinary
# Render-only self-heartbeat. Set false to stop it; local development is unaffected.
KEEP_ALIVE_ENABLED=true

# Django Core Security
# Generate a strong 50+ char random secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-very-long-cryptographically-secure-random-secret-key
# Local development only. Set DEBUG=False and exact hosts in deployment.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Optional client-visible application gate; do not treat as an authentication secret.
DATA_SECURITY_KEY=

# CORS & CSRF Whitelist (Comma-separated URLs of your deployed Client & Admin portals)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# SSL / Proxy Configuration
# Set to True in production with an active SSL certificate.
# If behind a reverse proxy/load balancer that terminates SSL (AWS ALB, Cloudflare, Render),
# ensure headers are forwarded properly.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email provider: brevo or resend (HTTPS APIs), or smtp.
# Configure this example to use Brevo; existing deployments keep their chosen provider.
EMAIL_PROVIDER=brevo
# Render Free blocks SMTP ports 465/587. Use an HTTPS provider there.
# For Hostinger SMTP use the full mailbox address and its mailbox password.
# Port 465 uses SSL; alternatively use port 587 with SSL=False and TLS=True.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=True
SMTP_USE_TLS=False

# Resend Email Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=CampXChange <onboarding@resend.dev>
# Optional real mailbox for replies. Leave empty to omit Reply-To.
RESEND_REPLY_TO_EMAIL=
# onboarding@resend.dev can send only to the email owning the Resend account.
# Sending to other users requires a verified sender domain you control.

# Brevo transactional email over HTTPS: free allowance, subject to Brevo account
# activation and sender verification. Never put the API key in a browser file.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CampXChange
# Google OAuth & Firebase Authentication Configuration
GOOGLE_CLIENT_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# Firebase Admin service-account key: private path or raw/base64 JSON. Never commit.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Google Gemini AI Configuration (Used for automated student ID card verification)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite


