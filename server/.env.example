# ==============================================================================
# LPUTrade Server Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Database: MongoDB connection URI (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campxchange?retryWrites=true&w=majority
# Local Example: mongodb://localhost:27017/campxchange
MONGODB_URI=mongodb://localhost:27017/campxchange
MONGODB_NAME=campxchange

# Django Core Security
# Generate a strong 50+ char random secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-very-long-cryptographically-secure-random-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,api.your-domain.com

# CORS & CSRF Whitelist (Comma-separated URLs of your deployed Client & Admin portals)
CORS_ALLOWED_ORIGINS=https://cxc.anshuman892494.online,https://cxc-marketplace.vercel.app,http://localhost:5173,http://localhost:5174
CSRF_TRUSTED_ORIGINS=https://cxc.anshuman892494.online,https://cxc-marketplace.vercel.app,http://localhost:5173,http://localhost:5174

# SSL / Proxy Configuration
# Set to True in production with an active SSL certificate.
# If behind a reverse proxy/load balancer that terminates SSL (AWS ALB, Cloudflare, Render),
# ensure headers are forwarded properly.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=CampXChange <onboarding@resend.dev>
# Google OAuth & Firebase Authentication Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
# Firebase Admin SDK Service Account (Path to JSON file, or raw JSON string, or leave blank for local mock/fallback)
FIREBASE_SERVICE_ACCOUNT_KEY=


